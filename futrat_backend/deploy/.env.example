# Copy to deploy/.env.production ON THE SERVER. All values below are placeholders.
FUTRAT_IMAGE=futrat-api:initial
FUTRAT_PROXY_NETWORK=futrat_proxy
FUTRAT_DATABASE_NETWORK=futrat_database

# Generate a different password and signing key. Use a hex password to avoid URL escaping.
DATABASE_URL=postgresql+psycopg2://futrat:REPLACE_WITH_DATABASE_PASSWORD@postgresql:5432/futrat
SECRET_KEY=REPLACE_WITH_GENERATED_SECRET_KEY_64_HEX
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional: add privately on the server; ESPN works without this key.
GOAL_API_KEY=
GOAL_API_DAILY_LIMIT=900
